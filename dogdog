<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>2026 Supplier AM vs Plan Report</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root {
  --bg: #F8FAFC; --surface: #FFFFFF; --border: #E2E8F0;
  --text: #1E293B; --text2: #64748B; --text3: #94A3B8;
  --blue: #2563EB; --blue-l: #3B82F6; --purple: #7C3AED;
  --amber: #D97706; --green: #059669; --red: #DC2626;
  --indigo: #6366F1;
  --good: #D1FAE5; --good-t: #065F46;
  --warn: #FEF3C7; --warn-t: #92400E;
  --bad: #FEE2E2; --bad-t: #991B1B;
  --shadow: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  --shadow-lg: 0 10px 25px rgba(0,0,0,.06), 0 4px 10px rgba(0,0,0,.03);
  --radius: 12px;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; -webkit-font-smoothing: antialiased; }

.container { max-width: 1400px; margin: 0 auto; padding: 24px 20px 60px; }

/* Header */
.report-header {
  background: linear-gradient(135deg, #1E293B 0%, #334155 100%);
  border-radius: var(--radius); padding: 40px 36px; margin-bottom: 32px;
  color: white; position: relative; overflow: hidden;
}
.report-header::after {
  content:''; position:absolute; top:-50%; right:-10%; width:400px; height:400px;
  background: radial-gradient(circle, rgba(99,102,241,.15) 0%, transparent 70%);
  border-radius:50%;
}
.report-header h1 { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; position: relative; z-index:1; }
.report-header p { font-size: 15px; color: #94A3B8; margin-top: 8px; position: relative; z-index:1; }
.report-header .badge {
  display: inline-block; background: rgba(99,102,241,.2); color: #A5B4FC;
  font-size: 12px; font-weight: 600; padding: 4px 12px; border-radius: 20px;
  margin-top: 12px; position: relative; z-index:1;
}

/* KPI Cards */
.kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px; }
.kpi-card {
  background: var(--surface); border-radius: var(--radius); padding: 24px;
  box-shadow: var(--shadow); border: 1px solid var(--border); transition: transform .2s, box-shadow .2s;
}
.kpi-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.kpi-label { font-size: 13px; color: var(--text2); font-weight: 500; margin-bottom: 8px; display:flex; align-items:center; gap:6px; }
.kpi-value { font-size: 26px; font-weight: 700; letter-spacing: -0.5px; }
.kpi-sub { font-size: 12px; color: var(--text3); margin-top: 4px; }
.kpi-dot { width:8px; height:8px; border-radius:50%; display:inline-block; }

/* Section */
.section {
  background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow);
  border: 1px solid var(--border); margin-bottom: 28px; overflow: hidden;
}
.section-head {
  padding: 24px 28px 20px; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;
}
.section-head h2 { font-size: 18px; font-weight: 700; display:flex; align-items:center; gap:10px; }
.section-head h2 .icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:16px; }
.section-head .sub { font-size: 13px; color: var(--text2); }
.section-body { padding: 24px 28px 28px; }

/* Table wrapper */
.table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -4px; padding: 0 4px; }
.table-wrap::-webkit-scrollbar { height: 6px; }
.table-wrap::-webkit-scrollbar-track { background: #F1F5F9; border-radius: 3px; }
.table-wrap::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 3px; }

/* Tables */
table { width: 100%; border-collapse: collapse; font-size: 13px; }
thead th {
  padding: 10px 12px; font-weight: 600; font-size: 12px; text-transform: uppercase;
  letter-spacing: 0.3px; white-space: nowrap; border-bottom: 2px solid var(--border);
  position: sticky; top: 0; background: var(--surface); z-index: 2;
}
th.am-h { color: var(--blue-l); } th.pl-h { color: var(--purple); }
th.rt-h { color: var(--amber); } th.ytd-h { color: var(--green); }
th.main-h { color: var(--blue); }
tbody td { padding: 10px 12px; border-bottom: 1px solid #F1F5F9; white-space: nowrap; text-align: right; }
tbody td:first-child { text-align: left; font-weight: 600; color: var(--blue); position: sticky; left: 0; background: inherit; z-index: 1; }
tbody tr:hover { background: #F8FAFC; }
tbody tr:nth-child(even) { background: #FAFBFC; }
tbody tr:nth-child(even):hover { background: #F1F5F9; }
tr.total-row td { font-weight: 700; color: var(--blue); background: #EFF6FF !important; border-top: 2px solid var(--blue); }

.rate-cell { font-weight: 700; border-radius: 4px; text-align: center; min-width: 58px; }
.rate-good { color: var(--good-t); background: var(--good); }
.rate-warn { color: var(--warn-t); background: var(--warn); }
.rate-bad { color: var(--bad-t); background: var(--bad); }

/* Summary table */
.summary-table td { padding: 14px 16px; font-size: 14px; }
.summary-table td:first-child { min-width: 200px; }
.rating-badge {
  display: inline-flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; border-radius: 8px; font-weight: 800; font-size: 18px;
}
.rating-A { background: var(--good); color: var(--good-t); }
.rating-B { background: #DBEAFE; color: #1E40AF; }
.rating-C { background: var(--warn); color: var(--warn-t); }
.rating-D { background: var(--bad); color: var(--bad-t); }

.status-tag {
  display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600;
}
.status-good { background: var(--good); color: var(--good-t); }
.status-warn { background: var(--warn); color: var(--warn-t); }
.status-bad { background: var(--bad); color: var(--bad-t); }

.gap-pos { color: var(--red); font-weight: 700; }
.gap-neg { color: var(--green); font-weight: 700; }

/* Chart container */
.chart-container { position: relative; width: 100%; max-width: 100%; margin: 24px auto 0; }
.chart-container canvas { max-height: 400px; }

/* Severity tags */
.sev-complete { background: var(--bad); color: var(--bad-t); padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 12px; }
.sev-severe { background: #FED7AA; color: #9A3412; padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 12px; }
.sev-below { background: var(--warn); color: var(--warn-t); padding: 3px 10px; border-radius: 6px; font-weight: 700; font-size: 12px; }
.action-tag { font-size: 11px; color: var(--text3); }

/* Footer */
.report-footer { text-align: center; padding: 32px 20px; color: var(--text3); font-size: 13px; }

/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 768px) {
  .container { padding: 16px 12px 40px; }
  .report-header { padding: 28px 20px; }
  .report-header h1 { font-size: 22px; }
  .kpi-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
  .kpi-card { padding: 16px; }
  .kpi-value { font-size: 22px; }
  .section-head { padding: 16px 18px 14px; }
  .section-head h2 { font-size: 16px; }
  .section-body { padding: 16px 14px 20px; }
  table { font-size: 12px; }
  thead th, tbody td { padding: 8px 8px; }
  .summary-table td { padding: 10px 12px; font-size: 13px; }
  .chart-container canvas { max-height: 280px; }
}
@media (max-width: 480px) {
  .kpi-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
  .kpi-card { padding: 14px; }
  .kpi-label { font-size: 11px; }
  .kpi-value { font-size: 18px; }
  .kpi-sub { font-size: 11px; }
  .report-header h1 { font-size: 20px; }
  .section-head { flex-direction: column; align-items: flex-start; }
}

/* Print */
@media print {
  body { background: white; }
  .section { break-inside: avoid; box-shadow: none; border: 1px solid #ddd; }
  .kpi-card { box-shadow: none; }
}

/* Animations */
@keyframes fadeUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
.section, .kpi-card { animation: fadeUp .5s ease-out both; }
.section:nth-child(2) { animation-delay: .05s; }
.section:nth-child(3) { animation-delay: .1s; }
.section:nth-child(4) { animation-delay: .15s; }
</style>
</head>
<body>

<div class="container">

<!-- Header -->
<div class="report-header">
  <h1>2026 Supplier Performance Report</h1>
  <p>AM Actual vs Plan Target — 各供应商月度及年度达成率分析</p>
  <span class="badge">FY 2026 · Jan – Dec</span>
</div>

<!-- KPI Cards -->
<div class="kpi-grid" id="kpiGrid"></div>

<!-- Section 1: 年度汇总 -->
<div class="section">
  <div class="section-head">
    <h2><span class="icon" style="background:#EFF6FF;color:#2563EB;">&#9733;</span> 年度汇总分析</h2>
    <span class="sub">Annual AM vs Plan Summary</span>
  </div>
  <div class="section-body">
    <div class="table-wrap">
      <table class="summary-table" id="summaryTable"></table>
    </div>
    <div class="chart-container" style="margin-top:32px;">
      <canvas id="butterflyChart"></canvas>
    </div>
  </div>
</div>

<!-- Section 2: 月度趋势 -->
<div class="section">
  <div class="section-head">
    <h2><span class="icon" style="background:#F0FDF4;color:#059669;">&#9650;</span> 月度趋势</h2>
    <span class="sub">Monthly AM vs Plan Trend</span>
  </div>
  <div class="section-body">
    <div class="table-wrap">
      <table id="trendTable"></table>
    </div>
    <div class="chart-container" style="margin-top:28px;">
      <canvas id="trendChart"></canvas>
    </div>
  </div>
</div>

<!-- Section 3: 月度明细 -->
<div class="section">
  <div class="section-head">
    <h2><span class="icon" style="background:#EEF2FF;color:#6366F1;">&#9783;</span> 月度明细对比</h2>
    <span class="sub">Supplier Monthly Detail</span>
  </div>
  <div class="section-body">
    <div class="table-wrap">
      <table id="detailTable"></table>
    </div>
  </div>
</div>

<!-- Section 4: 丢单分析 -->
<div class="section">
  <div class="section-head">
    <h2><span class="icon" style="background:#FEE2E2;color:#DC2626;">&#9888;</span> 丢单分析</h2>
    <span class="sub">Critical Gap Analysis — 达成率 &lt; 50%</span>
  </div>
  <div class="section-body">
    <div class="table-wrap">
      <table id="gapTable"></table>
    </div>
    <div id="gapSummary" style="margin-top:20px;padding:16px 20px;background:#F8FAFC;border-radius:8px;font-size:13px;color:#64748B;"></div>
  </div>
</div>

<div class="report-footer">
  2026 Supplier AM vs Plan Report &middot; Generated with QoderWork
</div>

</div>

<script>
// ===== DATA =====
const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const monthsCN = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'];
const companies = [
  'Eckerle Zhuhai (Bosch, Aumovio)', 'NIDEC MOTOR', 'Hyunbo Suzhou (Bosch)',
  'Fineworld (Bosch, Brose)', 'Tianlong (Nidec)', 'Brose Taicang',
  'JEBSEE TW', 'imi (Valeo)', 'ASNP SY', 'Tyco'
];
const amData = [
  [2700000,2644800,1579200,4711200,3074400,2791200,3182400,1588800,4344000,3124800,3307200,0],
  [3337800,1679400,1922700,1606200,1621800,1762200,2547600,1759200,2023800,1514400,1933800,54000],
  [835200,499200,316800,940800,576000,460800,710400,288000,633600,345600,403200,403200],
  [1520400,96000,640800,480000,752400,480000,976800,1376400,0,144000,704400,560400],
  [239400,786600,217800,172800,115200,257400,288000,266400,115200,172800,613800,0],
  [705600,588000,470400,705600,705600,0,940800,705600,352800,0,470400,705600],
  [144000,172800,0,115200,144000,115200,144000,0,144000,230400,0,0],
  [0,0,0,31200,0,15600,15600,62400,62400,62400,46800,78000],
  [0,0,0,0,33600,134400,168000,67200,100800,201600,0,134400],
  [270000,54000,54000,126000,72000,54000,54000,54000,54000,36000,0,0]
];
const planData = [
  [5448336,3988196,4773372,4915000,4190882,4478292,4084267,4254407,4857650,3966938,4469048,4719856],
  [2488200,1681200,2014200,2187000,2241000,2035800,2083800,2159400,2633400,1983600,2262600,2159400],
  [947600,564000,712800,697600,601200,649600,673600,784400,869600,703600,842800,997600],
  [752400,272400,752400,464400,656400,368400,656400,272400,752400,272400,464400,848400],
  [835200,275400,844200,275400,635400,324000,408600,484200,559800,426600,502200,408600],
  [940800,470400,940800,823200,823200,823200,823200,823200,940800,823200,823200,823200],
  [172800,144000,144000,144000,144000,144000,144000,172800,172800,144000,172800,144000],
  [0,0,15600,15600,15600,31200,15600,31200,46800,15600,31200,31200],
  [33600,33600,67200,100800,67200,100800,33600,67200,67200,33600,67200,33600],
  [108000,108000,108000,108000,108000,108000,108000,108000,108000,108000,108000,108000]
];

// Derived
const sum = arr => arr.reduce((a,b) => a+b, 0);
const totalAM = months.map((_,m) => amData.reduce((s,r) => s+r[m], 0));
const totalPlan = months.map((_,m) => planData.reduce((s,r) => s+r[m], 0));
const compAM = companies.map((_,i) => sum(amData[i]));
const compPlan = companies.map((_,i) => sum(planData[i]));
const totalAMSum = sum(totalAM), totalPlanSum = sum(totalPlan);
const overallRate = totalAMSum / totalPlanSum;
const fmt = n => n.toLocaleString('en-US');
const fmtM = n => (n/1e6).toFixed(1) + 'M';
const pct = r => (r * 100).toFixed(1) + '%';
const rateClass = r => r >= 1 ? 'rate-good' : r >= 0.7 ? 'rate-warn' : r > 0 ? 'rate-bad' : '';

// ===== KPI CARDS =====
const kpiGrid = document.getElementById('kpiGrid');
const kpis = [
  { label:'总 AM 实际', value:fmtM(totalAMSum), sub:fmt(totalAMSum), color:'var(--blue)', dot:'#3B82F6' },
  { label:'总 Plan 目标', value:fmtM(totalPlanSum), sub:fmt(totalPlanSum), color:'var(--purple)', dot:'#7C3AED' },
  { label:'整体达成率', value:pct(overallRate), sub:overallRate>=0.7?'接近达标':'需要关注', color:overallRate>=1?'var(--green)':overallRate>=0.7?'var(--amber)':'var(--red)', dot:overallRate>=1?'#059669':overallRate>=0.7?'#D97706':'#DC2626' },
  { label:'差额 (Plan-AM)', value:fmtM(totalPlanSum-totalAMSum), sub:totalPlanSum>totalAMSum?'未达标缺口':'超额完成', color:totalPlanSum>totalAMSum?'var(--red)':'var(--green)', dot:totalPlanSum>totalAMSum?'#DC2626':'#059669' }
];
kpis.forEach(k => {
  kpiGrid.innerHTML += `<div class="kpi-card"><div class="kpi-label"><span class="kpi-dot" style="background:${k.dot}"></span>${k.label}</div><div class="kpi-value" style="color:${k.color}">${k.value}</div><div class="kpi-sub">${k.sub}</div></div>`;
});

// ===== SUMMARY TABLE (年度汇总) =====
const st = document.getElementById('summaryTable');
let h = '<thead><tr><th class="main-h">Supplier</th><th class="am-h">AM Actual</th><th class="pl-h">Plan Target</th><th style="color:var(--text2)">Gap</th><th class="rt-h">Achievement</th><th class="rt-h">Status</th><th class="ytd-h">Rating</th></tr></thead><tbody>';
companies.forEach((name, i) => {
  const am=compAM[i], pl=compPlan[i], diff=pl-am, rate=am/pl;
  const rc=rateClass(rate);
  const status = rate>=1?'On Track':rate>=0.9?'Near Target':rate>=0.7?'Below Target':'Critical';
  const sc = rate>=1?'status-good':rate>=0.7?'status-warn':'status-bad';
  const rating = rate>=1?'A':rate>=0.9?'B':rate>=0.7?'C':'D';
  h += `<tr><td>${name}</td><td>${fmt(am)}</td><td>${fmt(pl)}</td><td class="${diff>0?'gap-pos':'gap-neg'}">${diff>0?'+':''}${fmt(diff)}</td><td class="rate-cell ${rc}">${pct(rate)}</td><td><span class="status-tag ${sc}">${status}</span></td><td><span class="rating-badge rating-${rating}">${rating}</span></td></tr>`;
});
const dr=totalAMSum/totalPlanSum, dd=totalPlanSum-totalAMSum;
const ds=dr>=1?'On Track':dr>=0.9?'Near Target':dr>=0.7?'Below Target':'Critical';
const dsc=dr>=1?'status-good':dr>=0.7?'status-warn':'status-bad';
const drt=dr>=1?'A':dr>=0.9?'B':dr>=0.7?'C':'D';
h += `<tr class="total-row"><td>TOTAL</td><td>${fmt(totalAMSum)}</td><td>${fmt(totalPlanSum)}</td><td class="${dd>0?'gap-pos':'gap-neg'}">${dd>0?'+':''}${fmt(dd)}</td><td class="rate-cell ${rateClass(dr)}">${pct(dr)}</td><td><span class="status-tag ${dsc}">${ds}</span></td><td><span class="rating-badge rating-${drt}">${drt}</span></td></tr>`;
h += '</tbody>';
st.innerHTML = h;

// ===== BUTTERFLY CHART =====
const bCtx = document.getElementById('butterflyChart').getContext('2d');
new Chart(bCtx, {
  type: 'bar',
  data: {
    labels: companies.map(n => n.length > 28 ? n.substring(0,26)+'...' : n),
    datasets: [
      { label:'AM Actual', data: compAM.map(v => -v/1e6), backgroundColor:'rgba(59,130,246,.75)', borderRadius:4, borderSkipped:false },
      { label:'Plan Target', data: compPlan.map(v => v/1e6), backgroundColor:'rgba(124,58,237,.65)', borderRadius:4, borderSkipped:false }
    ]
  },
  options: {
    indexAxis: 'y', responsive: true, maintainAspectRatio: false,
    plugins: {
      legend: { position:'bottom', labels:{ font:{size:12}, usePointStyle:true, padding:20 } },
      tooltip: {
        callbacks: {
          label: ctx => {
            const v = Math.abs(ctx.raw);
            const i = ctx.dataIndex;
            if(ctx.datasetIndex===0) return ` AM: ${v.toFixed(1)}M  (${pct(compAM[i]/compPlan[i])})`;
            return ` Plan: ${v.toFixed(1)}M`;
          }
        }
      }
    },
    scales: {
      x: {
        stacked: false, grid: { color:'#E2E8F0' },
        ticks: { callback: v => Math.abs(v).toFixed(0)+'M', color:'#94A3B8', font:{size:11} }
      },
      y: {
        ticks: { font:{size:11, weight:'600'}, color:'#1E293B' },
        grid: { display:false }
      }
    }
  }
});
document.getElementById('butterflyChart').parentElement.style.height = Math.max(360, companies.length * 42) + 'px';

// ===== TREND TABLE (月度趋势) =====
const tt = document.getElementById('trendTable');
let th = '<thead><tr><th class="main-h">Month</th><th class="am-h">AM</th><th class="pl-h">Plan</th><th class="rt-h">Rate</th><th style="color:var(--text2)">Gap</th></tr></thead><tbody>';
monthsCN.forEach((m, i) => {
  const am=totalAM[i], pl=totalPlan[i], rate=pl>0?am/pl:0, gap=pl-am;
  th += `<tr><td>${m}</td><td>${fmt(am)}</td><td>${fmt(pl)}</td><td class="rate-cell ${rateClass(rate)}">${pct(rate)}</td><td class="${gap>0?'gap-pos':'gap-neg'}">${gap>0?'+':''}${fmt(gap)}</td></tr>`;
});
const tam=sum(totalAM), tpl=sum(totalPlan), trt=tam/tpl, tgap=tpl-tam;
th += `<tr class="total-row"><td>TOTAL</td><td>${fmt(tam)}</td><td>${fmt(tpl)}</td><td class="rate-cell ${rateClass(trt)}">${pct(trt)}</td><td class="${tgap>0?'gap-pos':'gap-neg'}">${tgap>0?'+':''}${fmt(tgap)}</td></tr>`;
th += '</tbody>';
tt.innerHTML = th;

// ===== TREND CHART (combo bar+line) =====
const tCtx = document.getElementById('trendChart').getContext('2d');
const trendRates = months.map((_,i) => totalPlan[i]>0 ? +(totalAM[i]/totalPlan[i]*100).toFixed(1) : 0);
new Chart(tCtx, {
  type: 'bar',
  data: {
    labels: monthsCN,
    datasets: [
      { label:'AM', data: totalAM.map(v=>v/1e6), backgroundColor:'rgba(59,130,246,.7)', borderRadius:4, order:2, yAxisID:'y' },
      { label:'Plan', data: totalPlan.map(v=>v/1e6), backgroundColor:'rgba(124,58,237,.5)', borderRadius:4, order:2, yAxisID:'y' },
      { label:'Achievement %', data: trendRates, type:'line', borderColor:'#D97706', backgroundColor:'rgba(217,119,6,.1)', pointBackgroundColor:'#D97706', pointRadius:4, pointHoverRadius:6, borderWidth:2.5, tension:0.3, fill:false, yAxisID:'y1', order:1 }
    ]
  },
  options: {
    responsive:true, maintainAspectRatio:false,
    plugins: {
      legend: { position:'bottom', labels:{ font:{size:12}, usePointStyle:true, padding:20 } },
      tooltip: { callbacks: { label: ctx => {
        if(ctx.datasetIndex===2) return ` Rate: ${ctx.raw}%`;
        return ` ${ctx.dataset.label}: ${ctx.raw.toFixed(1)}M`;
      }}}
    },
    scales: {
      y: { position:'left', grid:{color:'#F1F5F9'}, ticks:{callback:v=>v+'M', color:'#94A3B8', font:{size:11}} },
      y1: { position:'right', min:0, max:120, grid:{drawOnChartArea:false}, ticks:{callback:v=>v+'%', color:'#D97706', font:{size:11}} },
      x: { grid:{display:false}, ticks:{color:'#64748B', font:{size:11}} }
    }
  }
});
document.getElementById('trendChart').parentElement.style.height = '380px';

// ===== DETAIL TABLE (月度明细) =====
const dt = document.getElementById('detailTable');
let dh = '<thead><tr><th class="main-h" style="min-width:180px">Supplier</th>';
monthsCN.forEach(m => { dh += `<th class="am-h">${m} AM</th><th class="pl-h">${m} Plan</th><th class="rt-h">${m} %</th>`; });
dh += '<th class="ytd-h">YTD AM</th><th class="ytd-h">YTD Plan</th><th class="ytd-h">YTD %</th></tr></thead><tbody>';

companies.forEach((name, i) => {
  dh += `<tr><td>${name}</td>`;
  months.forEach((_, m) => {
    const am=amData[i][m], pl=planData[i][m], rate=pl>0?am/pl:(am===0?0:999);
    dh += `<td>${fmt(am)}</td><td>${fmt(pl)}</td>`;
    if(rate < 999) dh += `<td class="rate-cell ${rateClass(rate)}">${pct(rate)}</td>`;
    else dh += `<td style="color:#94A3B8;text-align:center">N/A</td>`;
  });
  const tam=compAM[i], tpl=compPlan[i], yr=tpl>0?tam/tpl:0;
  dh += `<td style="font-weight:700">${fmt(tam)}</td><td style="font-weight:700">${fmt(tpl)}</td><td class="rate-cell ${rateClass(yr)}" style="font-weight:700">${pct(yr)}</td></tr>`;
});

dh += `<tr class="total-row"><td>TOTAL</td>`;
months.forEach((_, m) => {
  const am=totalAM[m], pl=totalPlan[m], rate=pl>0?am/pl:0;
  dh += `<td>${fmt(am)}</td><td>${fmt(pl)}</td><td class="rate-cell ${rateClass(rate)}">${pct(rate)}</td>`;
});
dh += `<td>${fmt(totalAMSum)}</td><td>${fmt(totalPlanSum)}</td><td class="rate-cell ${rateClass(overallRate)}">${pct(overallRate)}</td></tr></tbody>`;
dt.innerHTML = dh;

// ===== GAP TABLE (丢单分析) =====
const lostData = [];
companies.forEach((name, i) => {
  monthsCN.forEach((m, mi) => {
    const am=amData[i][mi], pl=planData[i][mi];
    if(pl > 0 && am/pl < 0.5) {
      const rate = am/pl;
      const level = rate<=0.05?'Complete Loss':rate<=0.3?'Severe':'Below Standard';
      const action = rate<=0.05?'Root Cause Review':rate<=0.3?'Urgent Follow-up':'Monitor & Adjust';
      lostData.push({name, month:m, am, pl, diff:pl-am, rate, level, action});
    }
  });
});
lostData.sort((a,b) => b.diff - a.diff);

const gt = document.getElementById('gapTable');
let gh = '<thead><tr><th class="main-h">Supplier</th><th style="color:var(--text2)">Month</th><th class="am-h">AM</th><th class="pl-h">Plan</th><th style="color:var(--red)">Gap</th><th class="rt-h">Rate</th><th style="color:var(--red)">Severity</th><th style="color:var(--text3)">Action</th></tr></thead><tbody>';
lostData.forEach(d => {
  const sc = d.level==='Complete Loss'?'sev-complete':d.level==='Severe'?'sev-severe':'sev-below';
  gh += `<tr><td>${d.name}</td><td>${d.month}</td><td>${fmt(d.am)}</td><td>${fmt(d.pl)}</td><td class="gap-pos">+${fmt(d.diff)}</td><td class="rate-cell rate-bad">${pct(d.rate)}</td><td><span class="${sc}">${d.level}</span></td><td class="action-tag">${d.action}</td></tr>`;
});
gh += '</tbody>';
gt.innerHTML = gh;

const cl = lostData.filter(d=>d.level==='Complete Loss').length;
const sv = lostData.filter(d=>d.level==='Severe').length;
const bl = lostData.filter(d=>d.level==='Below Standard').length;
document.getElementById('gapSummary').innerHTML = `Total <strong>${lostData.length}</strong> critical gaps &nbsp;|&nbsp; <span style="color:var(--red)">Complete Loss: ${cl}</span> &nbsp;|&nbsp; <span style="color:#9A3412">Severe: ${sv}</span> &nbsp;|&nbsp; <span style="color:var(--warn-t)">Below Standard: ${bl}</span>`;
</script>

</body>
</html>
